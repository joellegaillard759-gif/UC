---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const prestations = [
  { titre: "Terrasses et dalles extérieures", desc: "Dalle en béton, dallage sur lit de gravier ou pavés — avec la fondation, la pente d'écoulement et les joints de dilatation qui vont avec." },
  { titre: "Murets et murs de soutènement", desc: "Muret de délimitation ou mur qui retient de la terre. Le second n'a rien à voir avec le premier : il faut une fondation calculée, un drainage derrière et des barbacanes, sinon la poussée finit par l'emporter." },
  { titre: "Escaliers extérieurs", desc: "Escalier en béton coulé ou en pierre naturelle, avec des hauteurs de marche régulières, une pente d'égouttement et une finition qui ne devient pas glissante l'hiver." },
  { titre: "Allées et places", desc: "Accès de garage, place de parc ou chemin : béton, pavés autobloquants ou stabilisé, sur un fond de forme compacté et dimensionné pour ce qui va rouler dessus." },
  { titre: "Socles et fondations d'annexe", desc: "Bases pour abri de jardin, carport, pergola ou cabanon — descendues hors gel, même quand la construction est légère." },
  { titre: "Reprises et réparations", desc: "Dalle fissurée, muret qui penche, pavés qui se déchaussent, escalier dont le nez s'effrite : reprendre la partie atteinte plutôt que tout démolir, quand c'est possible." },
];

const faq = [
  {
    q: "Pourquoi ma terrasse en béton se fissure ?",
    a: "Trois causes reviennent presque toujours : un fond de forme mal compacté qui tasse ensuite, l'absence de joints de dilatation sur une grande surface, ou une dalle coulée trop mince pour ce qu'elle supporte. À cela s'ajoute le gel : l'eau qui reste sous la dalle gonfle en hiver et la soulève. C'est pour ça que le drainage compte autant que le béton lui-même.",
  },
  {
    q: "Quelle différence entre un muret et un mur de soutènement ?",
    a: "Un muret ne porte que lui-même. Un mur de soutènement retient de la terre, et cette terre pousse — d'autant plus quand elle est gorgée d'eau. Il lui faut donc une fondation dimensionnée, souvent une armature, un drainage à l'arrière et des barbacanes pour évacuer l'eau. Un mur de soutènement construit comme un muret finit par basculer ; c'est le défaut qu'on répare le plus souvent dans ce domaine. Au-delà d'une certaine hauteur, un ingénieur civil doit le calculer.",
  },
  {
    q: "Faut-il une autorisation pour une terrasse ou un mur au jardin ?",
    a: "Souvent, oui, au moins sous forme d'annonce à la commune. Les règles varient selon la commune, la distance à la limite de propriété et la hauteur du mur : un muret bas passe généralement sans problème, un mur de soutènement de plus d'un mètre presque jamais. On vérifie ce point avec vous avant de commencer.",
  },
  {
    q: "Quelle est la bonne saison pour ces travaux ?",
    a: "Du printemps à l'automne. Le béton ne prend pas correctement par temps de gel, et une chape ou un dallage frais pris par le gel est à refaire. Le printemps est aussi le moment où l'on voit le mieux les dégâts de l'hiver précédent — c'est souvent là que les gens nous appellent.",
  },
];
---

<Layout
  title="Aménagements extérieurs — Terrasses, murets, escaliers | Urben Construction"
  description="Terrasses, dalles, murets et murs de soutènement, escaliers extérieurs et allées dans le district de Morges. Visite sur place gratuite."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Aménagements extérieurs",
    "provider": {
      "@type": "LocalBusiness",
      "name": "Urben Construction",
      "url": "https://urbenconstruction.ch",
      "telephone": "+41218610155",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Grancy",
        "addressRegion": "Vaud",
        "addressCountry": "CH"
      }
    },
    "areaServed": "District de Morges, Vaud, Suisse",
    "description": "Terrasses et dalles extérieures, murets et murs de soutènement, escaliers, allées et socles d'annexe dans le district de Morges."
  })} />

  <Navbar />

  <!-- HEADER -->
  <section class="relative bg-gray-900 text-white pt-48 pb-20 overflow-hidden">
    <div class="absolute inset-0">
      <img src="/images/exterieurs.jpg" alt="Aménagements extérieurs district de Morges" class="w-full h-full object-cover opacity-25" />
    </div>
    <div class="relative max-w-[1440px] mx-auto px-6">
      <p class="text-xs font-semibold tracking-widest uppercase text-[#FF7500] mb-4">Domaines d'intervention</p>
      <h1 class="text-4xl md:text-6xl font-black leading-tight max-w-3xl">
        Aménagements<br />extérieurs.
      </h1>
      <p class="text-gray-300 mt-6 text-lg max-w-xl">
        Terrasses, murets, escaliers et allées — de la maçonnerie qui passe l'hiver dehors.
      </p>
      <div class="flex flex-wrap gap-4 mt-10">
        <a href="/contact" class="btn-orange btn-orange-on-dark px-8 py-4 text-sm font-bold tracking-widest uppercase rounded-sm">
          <span>Demander un devis gratuit</span>
        </a>
        <a href="tel:+41218610155" class="px-8 py-4 text-sm font-bold tracking-widest uppercase text-white border border-white/40 hover:border-white transition-colors rounded-sm">
          +41 21 861 01 55
        </a>
      </div>
    </div>
  </section>

  <!-- PRESTATIONS -->
  <section class="py-20 bg-white">
    <div class="max-w-[1440px] mx-auto px-6">
      <p class="text-xs font-semibold tracking-widest uppercase text-[#FF7500] mb-4">Ce qu'on fait</p>
      <h2 class="text-3xl font-bold mb-4">Dehors, tout est une question d'eau et de gel.</h2>
      <p class="text-gray-500 mb-14 max-w-xl">Un ouvrage extérieur subit chaque hiver ce qu'un mur intérieur ne subira jamais.</p>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {prestations.map(p => (
          <div class="bg-gray-50 rounded-xl p-6 border-t-2 border-[#FF7500]">
            <h3 class="text-base font-bold mb-2">{p.titre}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PHOTO + TEXTE -->
  <section class="py-20 bg-gray-50 border-y border-gray-100">
    <div class="max-w-[1440px] mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-16 items-center">
        <div>
          <p class="text-xs font-semibold tracking-widest uppercase text-[#FF7500] mb-4">Notre approche</p>
          <h2 class="text-3xl font-bold mb-6">Ce qui se joue sous la surface.</h2>
          <p class="text-gray-600 leading-relaxed mb-4">Sur un aménagement extérieur, la partie visible représente une petite part du travail. Le reste — décaissement, fond de forme compacté, drainage, fondation hors gel — ne se verra jamais, mais c'est lui qui décide si l'ouvrage sera intact dans dix ans ou fissuré dans trois.</p>
          <p class="text-gray-600 leading-relaxed mb-4">C'est aussi la partie qu'on peut réduire pour faire baisser un devis. Quand un prix concurrent est nettement plus bas, c'est souvent là que se trouve la différence — regardez ce que chaque devis prévoit sous la dalle.</p>
          <p class="text-gray-600 leading-relaxed mb-8">Zone d'intervention : district de Morges, Rolle, Aubonne, Cossonay et environs.</p>
          <a href="/contact" class="btn-orange inline-block px-8 py-4 text-sm font-bold tracking-widest uppercase rounded-sm">
            <span>Prendre contact</span>
          </a>
        </div>
        <div class="aspect-[4/3] overflow-hidden">
          <img src="/images/exterieurs.jpg" alt="Terrasse et muret maçonnés dans le canton de Vaud" class="w-full h-full object-cover" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-white">
    <div class="max-w-[1440px] mx-auto px-6">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold tracking-widest uppercase text-[#FF7500] mb-4">Questions fréquentes</p>
        <h2 class="text-3xl font-bold mb-12">Vos questions sur les aménagements extérieurs.</h2>
        <div class="space-y-0">
          {faq.map(item => (
            <details class="group border-t border-gray-200">
              <summary class="flex items-center justify-between py-5 cursor-pointer list-none select-none gap-4">
                <span class="text-sm font-semibold text-gray-900 leading-snug">{item.q}</span>
                <span class="text-[#FF7500] font-bold text-xl leading-none w-5 text-center flex-shrink-0 group-open:hidden">+</span>
                <span class="text-[#FF7500] font-bold text-xl leading-none w-5 text-center flex-shrink-0 hidden group-open:block">−</span>
              </summary>
              <p class="pb-6 text-sm text-gray-600 leading-relaxed">{item.a}</p>
            </details>
          ))}
          <div class="border-t border-gray-200"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-gray-900 text-white">
    <div class="max-w-[1440px] mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Un extérieur à aménager ?</h2>
      <p class="text-gray-400 mb-10">Visite sur place gratuite. Devis détaillé, sans engagement.</p>
      <a href="/contact" class="btn-orange btn-orange-on-dark inline-block px-12 py-4 text-sm font-bold tracking-widest uppercase rounded-sm">
        <span>Demander une visite gratuite</span>
      </a>
    </div>
  </section>

  <Footer />
</Layout>
