---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const signaux = [
  { titre: "Fissures", desc: "Une fissure fine et stable dans l'enduit est courante. Une fissure qui traverse, qui suit les joints en escalier ou qui s'ouvre d'année en année demande à être regardée de près." },
  { titre: "Taches et cloques", desc: "Auréoles sombres qui ne sèchent plus, peinture qui cloque, mousse verte au nord : l'eau reste dans l'enduit au lieu de s'évaporer." },
  { titre: "Dépôts blancs", desc: "Une poudre blanche à la surface, c'est du sel que l'eau a transporté depuis l'intérieur du mur. Le nettoyer ne sert à rien tant que l'eau continue de passer." },
  { titre: "Crépi qui se détache", desc: "Des plaques d'enduit qui sonnent creux ou tombent : le crépi n'adhère plus au support et la maçonnerie se retrouve à nu." },
];

const prestations = [
  { titre: "Ravalement et crépissage", desc: "Dépose de l'ancien enduit là où il ne tient plus, préparation du support, puis application du nouveau crépi. Un hydrofuge de finition peut être appliqué ensuite selon l'exposition de la façade." },
  { titre: "Réparation de fissures", desc: "Ouverture de la fissure, traitement du fond, pontage puis reprise de l'enduit et de la teinte. Une fissure qui bouge encore se traite différemment d'une fissure stabilisée — c'est ce qu'on regarde en premier." },
  { titre: "Réfection de balcon", desc: "Un balcon en béton qui s'effrite laisse apparaître ses fers : ils rouillent, gonflent et font éclater le béton par-dessous. On pique jusqu'au béton sain, on traite l'armature, on reconstitue, puis on reprend l'étanchéité et le rejet d'eau." },
  { titre: "Encadrement de fenêtre", desc: "Reprise de la maçonnerie autour d'une baie : embrasures, appui, linteau. C'est le travail qui accompagne un changement de fenêtres, ou qui répare les dégâts quand l'eau s'est infiltrée le long du cadre." },
  { titre: "Rejointoiement", desc: "Dégarnissage et reprise des joints de maçonnerie dégradés entre les pierres ou les briques, avec un mortier compatible avec le mur d'origine." },
  { titre: "Nettoyage avant travaux", desc: "Élimination des mousses, lichens et salissures pour retrouver le support avant de le traiter — sans pression excessive, qui abîme plus qu'elle ne nettoie." },
];

const faq = [
  {
    q: "Ma façade est fissurée — c'est urgent ?",
    a: "Ça dépend de la fissure. Une microfissure superficielle dans l'enduit est fréquente et sans conséquence structurelle : elle vient du retrait ou des écarts de température. Une fissure qui traverse le mur, qui s'ouvre d'une saison à l'autre, ou qui s'accompagne de portes qui coincent, mérite d'être regardée sans attendre. Le test le plus simple est de la mesurer et de la remesurer quelques mois plus tard.",
  },
  {
    q: "Faut-il une autorisation pour refaire une façade ?",
    a: "Si vous refaites à l'identique — même teinte, même type d'enduit — une annonce à la commune suffit généralement. Dès que la couleur ou l'aspect change, ou si le bâtiment se trouve en zone protégée ou au recensement architectural, la commune doit donner son accord avant les travaux. En PPE, il faut aussi la décision de l'assemblée des copropriétaires. On vérifie ce point avec vous avant de démarrer.",
  },
  {
    q: "Mon balcon s'effrite par en dessous, avec des traces de rouille — que faire ?",
    a: "C'est le signe que l'eau atteint les fers de l'armature. En rouillant, l'acier gonfle et fait sauter le béton qui l'entoure, ce qui laisse passer encore plus d'eau : le phénomène s'accélère tout seul. Reboucher par-dessus ne fait que le cacher. Il faut piquer jusqu'au béton sain, traiter l'acier, reconstituer, puis rétablir l'étanchéité et l'égouttement. Plus on attend, plus la part à démolir est grande.",
  },
  {
    q: "Quelle est la bonne saison pour un ravalement ?",
    a: "Du printemps à l'automne. Les enduits ne prennent pas correctement en dessous d'environ 5 °C, et le gel sur un enduit frais le détruit. La pleine chaleur d'été n'est pas idéale non plus : un enduit qui sèche trop vite fissure. Les meilleures périodes sont donc le printemps et la fin d'été.",
  },
  {
    q: "Faut-il un échafaudage ?",
    a: "Dès qu'on travaille en hauteur sur une façade complète, oui — c'est une question de sécurité et de qualité de travail. Sa location représente une part réelle du devis, et elle figure en ligne séparée pour que vous la voyiez. Si d'autres travaux sont prévus sur la même façade (fenêtres, ferblanterie, toiture), les regrouper permet de ne payer l'échafaudage qu'une fois.",
  },
];
---

<Layout
  title="Façades — Ravalement, balcons, encadrements | Urben Construction"
  description="Ravalement et rénovation de façade, réparation de fissures, réfection de balcons et encadrements de fenêtre dans le district de Morges."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Rénovation de façade",
    "provider": {
      "@type": "LocalBusiness",
      "name": "Urben Construction",
      "url": "https://urbenconstruction.ch",
      "telephone": "+41218610155",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Grancy",
        "addressRegion": "Vaud",
        "addressCountry": "CH"
      }
    },
    "areaServed": "District de Morges, Vaud, Suisse",
    "description": "Ravalement et rénovation de façade, réparation de fissures, réfection de balcons et encadrements de fenêtre dans le district de Morges."
  })} />

  <Navbar />

  <!-- HEADER -->
  <section class="relative bg-gray-900 text-white pt-48 pb-20 overflow-hidden">
    <div class="absolute inset-0">
      <img src="/images/facades.jpg" alt="Rénovation de façade district de Morges" class="w-full h-full object-cover opacity-25" />
    </div>
    <div class="relative max-w-[1440px] mx-auto px-6">
      <p class="text-xs font-semibold tracking-widest uppercase text-[#FF7500] mb-4">Domaines d'intervention</p>
      <h1 class="text-4xl md:text-6xl font-black leading-tight max-w-3xl">
        Façades.
      </h1>
      <p class="text-gray-300 mt-6 text-lg max-w-xl">
        Ravalement, réparation de fissures, réfection de balcons et encadrements de fenêtre — la façade protège la maçonnerie autant qu'elle l'habille.
      </p>
      <div class="flex flex-wrap gap-4 mt-10">
        <a href="/contact" class="btn-orange btn-orange-on-dark px-8 py-4 text-sm font-bold tracking-widest uppercase rounded-sm">
          <span>Demander un devis gratuit</span>
        </a>
        <a href="tel:+41218610155" class="px-8 py-4 text-sm font-bold tracking-widest uppercase text-white border border-white/40 hover:border-white transition-colors rounded-sm">
          +41 21 861 01 55
        </a>
      </div>
    </div>
  </section>

  <!-- SIGNAUX -->
  <section class="py-20 bg-white">
    <div class="max-w-[1440px] mx-auto px-6">
      <p class="text-xs font-semibold tracking-widest uppercase text-[#FF7500] mb-4">Reconnaître les signes</p>
      <h2 class="text-3xl md:text-4xl font-bold mb-4 max-w-2xl">Ce qu'il faut regarder.</h2>
      <p class="text-gray-500 mb-14 max-w-xl">Une façade abîmée n'est pas seulement laide : elle laisse entrer l'eau, et l'eau abîme ce qu'il y a derrière. Voici les quatre signes qui reviennent le plus souvent.</p>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {signaux.map(s => (
          <div class="bg-gray-50 rounded-xl p-6 border-t-2 border-[#FF7500]">
            <h3 class="text-base font-bold mb-2">{s.titre}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PRESTATIONS -->
  <section class="py-20 bg-gray-50 border-y border-gray-100">
    <div class="max-w-[1440px] mx-auto px-6">
      <p class="text-xs font-semibold tracking-widest uppercase text-[#FF7500] mb-4">Ce qu'on fait</p>
      <h2 class="text-3xl font-bold mb-14">Nos travaux de façade</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {prestations.map(p => (
          <div class="bg-white rounded-xl p-6">
            <h3 class="text-base font-bold mb-2">{p.titre}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PHOTO + TEXTE -->
  <section class="py-20 bg-white">
    <div class="max-w-[1440px] mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-16 items-center">
        <div class="aspect-[4/3] overflow-hidden">
          <img src="/images/realisations/grancy-avant.jpg" alt="Rénovation de façade à Grancy" class="w-full h-full object-cover" loading="lazy" />
        </div>
        <div>
          <p class="text-xs font-semibold tracking-widest uppercase text-[#FF7500] mb-4">Notre approche</p>
          <h2 class="text-3xl font-bold mb-6">Comprendre d'où vient l'eau avant de refermer.</h2>
          <p class="text-gray-600 leading-relaxed mb-4">Un enduit neuf appliqué sur un mur qui prend l'eau redevient exactement ce qu'il était, en deux ou trois hivers. On cherche donc d'abord par où l'eau entre : une fissure, un appui de fenêtre sans rejet, une ferblanterie percée, une remontée par le bas du mur. Parfois la réparation ne coûte presque rien et c'est le diagnostic qui valait la visite.</p>
          <p class="text-gray-600 leading-relaxed mb-4">Nous sommes deux frères et nous faisons la maçonnerie nous-mêmes. Pour l'échafaudage, la ferblanterie ou la peinture, on fait appel à des artisans avec qui on travaille depuis longtemps — et vous gardez le même interlocuteur.</p>
          <p class="text-gray-600 leading-relaxed mb-8">Zone d'intervention : district de Morges, Rolle, Aubonne, Cossonay et environs.</p>
          <a href="/contact" class="btn-orange inline-block px-8 py-4 text-sm font-bold tracking-widest uppercase rounded-sm">
            <span>Prendre contact</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-gray-50 border-t border-gray-100">
    <div class="max-w-[1440px] mx-auto px-6">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold tracking-widest uppercase text-[#FF7500] mb-4">Questions fréquentes</p>
        <h2 class="text-3xl font-bold mb-12">Vos questions sur les façades.</h2>
        <div class="space-y-0">
          {faq.map(item => (
            <details class="group border-t border-gray-200">
              <summary class="flex items-center justify-between py-5 cursor-pointer list-none select-none gap-4">
                <span class="text-sm font-semibold text-gray-900 leading-snug">{item.q}</span>
                <span class="text-[#FF7500] font-bold text-xl leading-none w-5 text-center flex-shrink-0 group-open:hidden">+</span>
                <span class="text-[#FF7500] font-bold text-xl leading-none w-5 text-center flex-shrink-0 hidden group-open:block">−</span>
              </summary>
              <p class="pb-6 text-sm text-gray-600 leading-relaxed">{item.a}</p>
            </details>
          ))}
          <div class="border-t border-gray-200"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-gray-900 text-white">
    <div class="max-w-[1440px] mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Une façade à reprendre ?</h2>
      <p class="text-gray-400 mb-10">Visite sur place gratuite. Devis détaillé, sans engagement.</p>
      <a href="/contact" class="btn-orange btn-orange-on-dark inline-block px-12 py-4 text-sm font-bold tracking-widest uppercase rounded-sm">
        <span>Demander une visite gratuite</span>
      </a>
    </div>
  </section>

  <Footer />
</Layout>
