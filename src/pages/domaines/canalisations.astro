---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const prestations = [
  { titre: "Réparation de fuite", desc: "Remplacement de la portion de conduite en cause une fois la fuite localisée — puis remblai et remise en état du sol ouvert." },
  { titre: "Mise en séparatif", desc: "Séparer le réseau d'eaux usées de celui des eaux claires, comme les communes vaudoises le demandent lors d'une rénovation ou d'un nouveau raccordement. Deux réseaux distincts jusqu'à la limite de parcelle." },
  { titre: "Eaux usées", desc: "Pose ou remplacement des conduites d'évacuation entre la maison et le collecteur communal : WC, cuisine, salle de bains, buanderie." },
  { titre: "Eaux claires", desc: "Reprise des descentes de toiture et des écoulements de surface, vers le collecteur d'eaux claires ou vers une infiltration sur la parcelle, selon ce qu'autorise la commune." },
  { titre: "Fourreaux de télécommunication", desc: "Pose des tubes qui recevront les câbles — téléphone, fibre, électricité — entre la limite de parcelle et le bâtiment, en même temps que la tranchée d'assainissement." },
  { titre: "Regards et remise en état", desc: "Pose ou remplacement des regards de visite et des tampons, pour que le réseau reste accessible ensuite. Puis rebouchage et remise en état de la surface." },
];

const faq = [
  {
    q: "C'est quoi, la mise en séparatif ?",
    a: "C'est le fait d'avoir deux réseaux distincts : un pour les eaux usées (WC, cuisine, douche) qui part vers la station d'épuration, et un pour les eaux claires (pluie de toiture, écoulements de surface) qui part vers un cours d'eau ou s'infiltre sur la parcelle. Beaucoup de maisons anciennes n'ont qu'un seul tuyau pour les deux. Les communes vaudoises demandent la séparation lors d'une rénovation d'assainissement ou d'un nouveau raccordement. Le règlement varie d'une commune à l'autre — c'est le service technique communal qui donne les exigences exactes.",
  },
  {
    q: "J'ai un bouchon ou une mauvaise odeur — vous pouvez venir ?",
    a: "Pas pour un bouchon. Nous n'avons ni caméra d'inspection ni camion hydrocureur : pour déboucher ou inspecter une conduite, appelez un service spécialisé, c'est plus rapide et moins cher. Nous, on intervient quand la conduite elle-même est en cause — cassée, affaissée, mal pentée, ou à remplacer. Si un service de débouchage vous dit que le problème revient à cause du tuyau, c'est là qu'on prend le relais.",
  },
  {
    q: "Qui paie la conduite entre ma maison et la route ?",
    a: "La partie privée — de la maison jusqu'au point de raccordement défini par la commune — est à la charge du propriétaire, entretien compris. Au-delà, c'est le réseau communal. Le point de séparation exact figure au règlement communal d'évacuation des eaux, et il n'est pas toujours en limite de parcelle. On le vérifie avec vous avant de chiffrer.",
  },
  {
    q: "Vous posez aussi les fourreaux pour la fibre ou l'électricité ?",
    a: "Oui, et c'est le bon moment pour le faire : la tranchée est déjà ouverte. On pose les tubes vides, avec un fil de tirage à l'intérieur. Le passage des câbles et le raccordement, en revanche, sont faits par l'électricien ou l'opérateur.",
  },
];
---

<Layout
  title="Canalisations et assainissement — District de Morges | Urben Construction"
  description="Fuite d'eau, mise en séparatif, eaux usées et eaux claires, fourreaux de télécommunication dans le district de Morges. Visite sur place gratuite."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Canalisations et assainissement",
    "provider": {
      "@type": "LocalBusiness",
      "name": "Urben Construction",
      "url": "https://urbenconstruction.ch",
      "telephone": "+41218610155",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Grancy",
        "addressRegion": "Vaud",
        "addressCountry": "CH"
      }
    },
    "areaServed": "District de Morges, Vaud, Suisse",
    "description": "Réparation de fuite, mise en séparatif, eaux usées, eaux claires et fourreaux de télécommunication dans le district de Morges."
  })} />

  <Navbar />

  <!-- HEADER -->
  <section class="relative bg-gray-900 text-white pt-48 pb-20 overflow-hidden">
    <div class="absolute inset-0">
      <img src="/images/canalisations.jpg" alt="Canalisations et assainissement district de Morges" class="w-full h-full object-cover opacity-25" />
    </div>
    <div class="relative max-w-[1440px] mx-auto px-6">
      <p class="text-xs font-semibold tracking-widest uppercase text-[#FF7500] mb-4">Domaines d'intervention</p>
      <h1 class="text-4xl md:text-6xl font-black leading-tight max-w-3xl">
        Canalisations<br />et assainissement.
      </h1>
      <p class="text-gray-300 mt-6 text-lg max-w-xl">
        Fuite, mise en séparatif, eaux usées, eaux claires et fourreaux — le réseau enterré entre votre maison et la route.
      </p>
      <div class="flex flex-wrap gap-4 mt-10">
        <a href="/contact" class="btn-orange btn-orange-on-dark px-8 py-4 text-sm font-bold tracking-widest uppercase rounded-sm">
          <span>Demander un devis gratuit</span>
        </a>
        <a href="tel:+41218610155" class="px-8 py-4 text-sm font-bold tracking-widest uppercase text-white border border-white/40 hover:border-white transition-colors rounded-sm">
          +41 21 861 01 55
        </a>
      </div>
    </div>
  </section>

  <!-- PRESTATIONS -->
  <section class="py-20 bg-white">
    <div class="max-w-[1440px] mx-auto px-6">
      <p class="text-xs font-semibold tracking-widest uppercase text-[#FF7500] mb-4">Ce qu'on fait</p>
      <h2 class="text-3xl font-bold mb-4">Le réseau qu'on ne voit qu'une fois ouvert.</h2>
      <p class="text-gray-500 mb-14 max-w-xl">Poser, remplacer, séparer, raccorder — et refermer proprement derrière.</p>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {prestations.map(p => (
          <div class="bg-gray-50 rounded-xl p-6 border-t-2 border-[#FF7500]">
            <h3 class="text-base font-bold mb-2">{p.titre}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PHOTO + TEXTE -->
  <section class="py-20 bg-gray-50 border-y border-gray-100">
    <div class="max-w-[1440px] mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-16 items-center">
        <div>
          <p class="text-xs font-semibold tracking-widest uppercase text-[#FF7500] mb-4">Notre approche</p>
          <h2 class="text-3xl font-bold mb-6">Ce qu'on fait, et ce qu'on ne fait pas.</h2>
          <p class="text-gray-600 leading-relaxed mb-4">On ne fait pas d'inspection par caméra et on ne débouche pas : ce sont d'autres métiers, avec d'autres machines. Notre part commence quand il faut ouvrir le sol et remplacer la conduite.</p>
          <p class="text-gray-600 leading-relaxed mb-4">Pour situer le problème, on travaille avec ce qui existe : les plans du réseau, les regards, la pente, l'âge de la maison. Quand un doute demeure, on ouvre une petite fouille de contrôle avant de chiffrer le reste — mieux vaut une tranchée d'essai qu'un devis à l'aveugle.</p>
          <p class="text-gray-600 leading-relaxed mb-8">Zone d'intervention : district de Morges, Rolle, Aubonne, Cossonay et environs.</p>
          <a href="/contact" class="btn-orange inline-block px-8 py-4 text-sm font-bold tracking-widest uppercase rounded-sm">
            <span>Prendre contact</span>
          </a>
        </div>
        <div class="aspect-[4/3] overflow-hidden">
          <img src="/images/canalisations.jpg" alt="Pose de canalisations dans le canton de Vaud" class="w-full h-full object-cover" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-white">
    <div class="max-w-[1440px] mx-auto px-6">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold tracking-widest uppercase text-[#FF7500] mb-4">Questions fréquentes</p>
        <h2 class="text-3xl font-bold mb-12">Vos questions sur les canalisations.</h2>
        <div class="space-y-0">
          {faq.map(item => (
            <details class="group border-t border-gray-200">
              <summary class="flex items-center justify-between py-5 cursor-pointer list-none select-none gap-4">
                <span class="text-sm font-semibold text-gray-900 leading-snug">{item.q}</span>
                <span class="text-[#FF7500] font-bold text-xl leading-none w-5 text-center flex-shrink-0 group-open:hidden">+</span>
                <span class="text-[#FF7500] font-bold text-xl leading-none w-5 text-center flex-shrink-0 hidden group-open:block">−</span>
              </summary>
              <p class="pb-6 text-sm text-gray-600 leading-relaxed">{item.a}</p>
            </details>
          ))}
          <div class="border-t border-gray-200"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-gray-900 text-white">
    <div class="max-w-[1440px] mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Une conduite à remplacer ?</h2>
      <p class="text-gray-400 mb-10">Visite sur place gratuite. Devis détaillé, sans engagement.</p>
      <a href="/contact" class="btn-orange btn-orange-on-dark inline-block px-12 py-4 text-sm font-bold tracking-widest uppercase rounded-sm">
        <span>Demander une visite gratuite</span>
      </a>
    </div>
  </section>

  <Footer />
</Layout>
