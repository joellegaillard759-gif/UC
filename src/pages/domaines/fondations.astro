---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const prestations = [
  {
    titre: "Semelles filantes en béton armé",
    desc: ["Les semelles filantes suivent le tracé des murs porteurs. Elles répartissent les charges linéaires sur une bande continue de béton armé. C'est le type de fondation le plus courant pour une maison individuelle sur sol stable."],
  },
  {
    titre: "Semelles isolées",
    desc: ["Les semelles isolées supportent des charges ponctuelles : poteaux, piliers de portail, angles de murs. Elles sont dimensionnées au cas par cas selon la charge et la portance du sol."],
  },
  {
    titre: "Radier",
    desc: ["Le radier est une dalle pleine en béton armé coulée sur toute la surface du bâtiment. On l'utilise quand le sol est peu porteur, instable ou humide. Il répartit le poids de manière uniforme et évite le tassement différentiel."],
  },
  {
    titre: "Fondations sur pieux",
    desc: ["Quand la bonne terre est trop profonde, on fore des pieux jusqu'à la couche portante. On les relie ensuite par des longrines ou un radier. C'est la solution pour les terrains argileux, les zones humides ou les constructions lourdes."],
  },
  {
    titre: "Fondations neuves pour extension, garage ou annexe",
    desc: [
      "Extension de maison, garage, abri de jardin ou mur de clôture : chaque projet exige une fondation adaptée à la charge et au sol. On ne reproduit pas une fondation d'un chantier à l'autre. Le dimensionnement dépend de la portance du terrain, du poids de la structure et du niveau de la nappe phréatique.",
      "Avant de couler, on inspecte le terrain. Si le sol est douteux, on fait réaliser une étude de sol G1 ou G2.",
    ],
  },
  {
    titre: "Reprise en sous-œuvre",
    desc: [
      "Sur du bâti existant, la reprise en sous-œuvre consolide ou approfondit une fondation défaillante. C'est une intervention technique et progressive : on travaille par plots successifs pour ne jamais déstabiliser l'ouvrage pendant les travaux.",
      "On ne reprend jamais une fondation à l'aveugle. Cette intervention exige souvent l'appui d'un ingénieur et un suivi rigoureux du chantier.",
    ],
  },
];

const criteres = [
  { titre: "La portance du sol", desc: "un sol stable accepte des semelles filantes. Un sol mauvais exige un radier ou des pieux." },
  { titre: "La charge du bâtiment", desc: "une maison en maçonnerie pleine n'a pas les mêmes besoins qu'un abri de jardin." },
  { titre: "Le niveau de l'eau", desc: "une nappe phréatique haute impose des précautions d'étanchéité et parfois un radier." },
];

const faq = [
  {
    q: "Quelle profondeur pour des fondations en Suisse ?",
    a: "On descend sous la profondeur de gel. En plaine romande, c'est souvent 80 cm à 1 m. En montagne ou sur sol instable, cela peut monter à 1,20 m ou plus.",
  },
  {
    q: "Combien coûtent les fondations d'une maison ?",
    a: "Le prix dépend du type de fondation et de la nature du sol. Des semelles filantes sur bon terrain coûtent moins cher qu'un radier ou des pieux. Sans visiter le terrain, tout devis est une estimation en l'air.",
  },
  {
    q: "Peut-on construire des fondations l'hiver ?",
    a: "Oui, mais le béton doit être protégé du gel. Il vaut mieux couler au printemps ou en automne si le temps est sec.",
  },
  {
    q: "Comment savoir si mes fondations sont endommagées ?",
    a: "Fissures en escalier sur les murs, portes qui ne ferment plus, plancher qui descend d'un côté : ce sont les signes d'un problème de fondation. Un diagnostic permet de trouver la cause avant d'intervenir.",
  },
];
---

<Layout
  title="Fondations — Gros œuvre et reprises en sous-œuvre | Urben Construction"
  description="Semelles filantes, semelles isolées, radier, pieux et reprises en sous-œuvre dans le district de Morges. Visite sur place gratuite."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Fondations",
    "provider": {
      "@type": "LocalBusiness",
      "name": "Urben Construction",
      "url": "https://urbenconstruction.ch",
      "telephone": "+41218610155",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Grancy",
        "addressRegion": "Vaud",
        "addressCountry": "CH"
      }
    },
    "areaServed": "District de Morges, Vaud, Suisse",
    "description": "Fondations neuves (semelles filantes, semelles isolées, radier, pieux) et reprises en sous-œuvre dans le district de Morges."
  })} />

  <Navbar />

  <!-- HEADER -->
  <section class="relative bg-gray-900 text-white pt-48 pb-20 overflow-hidden">
    <div class="absolute inset-0">
      <img src="/images/maison.jpg" alt="Fondations et béton armé district de Morges" class="w-full h-full object-cover opacity-25" />
    </div>
    <div class="relative max-w-[1440px] mx-auto px-6">
      <p class="text-xs font-semibold tracking-widest uppercase text-[#FF7500] mb-4">Domaines d'intervention</p>
      <h1 class="text-4xl md:text-6xl font-black leading-tight max-w-3xl">
        Fondations.
      </h1>
      <p class="text-gray-300 mt-6 text-lg max-w-xl">
        Gros œuvre et reprises en sous-œuvre.
      </p>
      <div class="flex flex-wrap gap-4 mt-10">
        <a href="/contact" class="btn-orange btn-orange-on-dark px-8 py-4 text-sm font-bold tracking-widest uppercase rounded-sm">
          <span>Demander un devis gratuit</span>
        </a>
        <a href="tel:+41218610155" class="px-8 py-4 text-sm font-bold tracking-widest uppercase text-white border border-white/40 hover:border-white transition-colors rounded-sm">
          +41 21 861 01 55
        </a>
      </div>
    </div>
  </section>

  <!-- PRESTATIONS -->
  <section class="py-20 bg-white">
    <div class="max-w-[1440px] mx-auto px-6">
      <div class="max-w-2xl mb-14">
        <p class="text-gray-600 leading-relaxed mb-4">La fondation transmet au sol le poids du bâtiment. Une fondation correctement dimensionnée répartit cette charge sans tassement. Mal conçue ou affaiblie, elle entraîne fissures, affaissements et désordres dans tout l'édifice.</p>
        <p class="text-gray-600 leading-relaxed">Nous réalisons des fondations neuves et des reprises en sous-œuvre pour maisons individuelles, extensions, dépendances et murs de soutènement en Suisse romande.</p>
      </div>
      <h2 class="text-3xl font-bold mb-10">Types de fondations que nous réalisons</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {prestations.map(p => (
          <div class="bg-gray-50 rounded-xl p-6 border-t-2 border-[#FF7500]">
            <h3 class="text-base font-bold mb-2">{p.titre}</h3>
            {p.desc.map(d => (
              <p class="text-sm text-gray-600 leading-relaxed mb-3 last:mb-0">{d}</p>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PHOTO + TEXTE -->
  <section class="py-20 bg-gray-50 border-y border-gray-100">
    <div class="max-w-[1440px] mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="text-3xl font-bold mb-6">Comment choisir le bon type de fondation ?</h2>
          <p class="text-gray-600 leading-relaxed mb-4">Le choix dépend de trois facteurs :</p>
          <ol class="space-y-3 mb-10">
            {criteres.map((c, i) => (
              <li class="flex gap-4 text-gray-600 leading-relaxed">
                <span class="text-[#FF7500] font-bold flex-shrink-0">{i + 1}.</span>
                <span><strong class="text-gray-900">{c.titre}</strong> : {c.desc}</span>
              </li>
            ))}
          </ol>
          <h3 class="text-xl font-bold mb-3">Étude de sol G1 ou G2</h3>
          <p class="text-gray-600 leading-relaxed mb-8">Pour les constructions neuves ou les reprises importantes, une étude de sol est indispensable. Elle définit la composition du terrain, la profondeur du bon sol et les risques de tassement. On vous oriente vers un géotechnicien si nécessaire.</p>
          <a href="/contact" class="btn-orange inline-block px-8 py-4 text-sm font-bold tracking-widest uppercase rounded-sm">
            <span>Prendre contact</span>
          </a>
        </div>
        <div class="aspect-[4/3] overflow-hidden">
          <img src="/images/realisations/perroy.jpg" alt="Fondation en béton armé sur un chantier vaudois" class="w-full h-full object-cover" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-white">
    <div class="max-w-[1440px] mx-auto px-6">
      <div class="max-w-3xl">
        <h2 class="text-3xl font-bold mb-12">Questions fréquentes sur les fondations</h2>
        <div class="space-y-0">
          {faq.map(item => (
            <details class="group border-t border-gray-200">
              <summary class="flex items-center justify-between py-5 cursor-pointer list-none select-none gap-4">
                <span class="text-sm font-semibold text-gray-900 leading-snug">{item.q}</span>
                <span class="text-[#FF7500] font-bold text-xl leading-none w-5 text-center flex-shrink-0 group-open:hidden">+</span>
                <span class="text-[#FF7500] font-bold text-xl leading-none w-5 text-center flex-shrink-0 hidden group-open:block">−</span>
              </summary>
              <p class="pb-6 text-sm text-gray-600 leading-relaxed">{item.a}</p>
            </details>
          ))}
          <div class="border-t border-gray-200"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-gray-900 text-white">
    <div class="max-w-[1440px] mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Notre zone d'intervention</h2>
      <p class="text-gray-400 mb-10 max-w-2xl mx-auto">Nous réalisons des fondations et travaux de gros œuvre dans le district de Morges. Chaque terrain est différent : contactez-nous pour une visite sur place.</p>
      <a href="/contact" class="btn-orange btn-orange-on-dark inline-block px-12 py-4 text-sm font-bold tracking-widest uppercase rounded-sm">
        <span>Demander une visite gratuite</span>
      </a>
    </div>
  </section>

  <Footer />
</Layout>
