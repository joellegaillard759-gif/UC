---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const prestations = [
  { titre: "Dalle en béton", desc: "Le plancher porteur : coffrage, armature et coulage d'une dalle en béton armé pour un sous-sol, un rez, un garage ou une extension." },
  { titre: "Chape liée", desc: "Chape en mortier de ciment coulée directement sur le support, sans couche intermédiaire. C'est la solution la plus simple quand la hauteur disponible est limitée." },
  { titre: "Chape flottante", desc: "Chape coulée sur un isolant phonique ou thermique, désolidarisée des murs. Plus épaisse, mais c'est elle qui coupe les bruits de pas entre deux niveaux." },
  { titre: "Chape sur plancher chauffant", desc: "Le chauffagiste pose son réseau de tuyaux, on coule la chape par-dessus en respectant l'enrobage et les joints de fractionnement. La mise en chauffe se fait ensuite, progressivement." },
  { titre: "Ragréage et remise à niveau", desc: "Rattrapage d'un sol existant creux, bosselé ou fissuré, pour que le revêtement final se pose sur un support plan." },
  { titre: "Démolition et évacuation", desc: "Dépose d'une ancienne chape ou dalle, évacuation des gravats et préparation du support avant de recouler." },
];

const faq = [
  {
    q: "Combien de temps faut-il attendre avant de poser le carrelage ou le parquet ?",
    a: "Plus longtemps qu'on ne voudrait. Une chape ciment traditionnelle demande environ une semaine par centimètre d'épaisseur pour les premiers centimètres, et le séchage ralentit ensuite — pour une chape courante, comptez plutôt un à deux mois selon la saison et l'aération. Avec un plancher chauffant, il faut en plus faire la mise en chauffe avant la pose. Le carreleur ou le parqueteur mesure l'humidité résiduelle avant de commencer : c'est lui qui donne le feu vert, pas le calendrier.",
  },
  {
    q: "Chape liée ou chape flottante ?",
    a: "La chape flottante isole du bruit et du froid, mais demande de la hauteur — souvent 8 à 10 cm avec l'isolant. La chape liée prend moins de place et coûte moins cher, mais transmet les bruits. En rénovation, c'est très souvent la hauteur disponible sous les portes qui tranche la question.",
  },
  {
    q: "Mon carrelage sonne creux par endroits — c'est grave ?",
    a: "Ça veut dire que le carreau n'adhère plus au support, soit parce que la colle a mal pris, soit parce que la chape en dessous se décolle ou s'est fissurée. Quelques carreaux isolés se reprennent. Si ça sonne creux sur une grande surface, c'est la chape qu'il faut reprendre, et refaire le revêtement par-dessus ne réglera rien.",
  },
  {
    q: "Vous posez aussi le carrelage ?",
    a: "Non — on s'arrête à la chape. La pose du carrelage, du parquet ou de la résine est un autre métier, et le résultat s'en ressent quand on veut faire les deux. Nous travaillons avec des carreleurs et des parqueteurs du coin, et si vous nous confiez le chantier entier, c'est nous qui les coordonnons.",
  },
];
---

<Layout
  title="Sols et planchers — Dalles béton et chapes | Urben Construction"
  description="Dalles en béton armé, chapes liées ou flottantes, chape sur plancher chauffant et ragréage dans le district de Morges. Visite sur place gratuite."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Sols et planchers",
    "provider": {
      "@type": "LocalBusiness",
      "name": "Urben Construction",
      "url": "https://urbenconstruction.ch",
      "telephone": "+41218610155",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Grancy",
        "addressRegion": "Vaud",
        "addressCountry": "CH"
      }
    },
    "areaServed": "District de Morges, Vaud, Suisse",
    "description": "Dalles en béton armé, chapes liées et flottantes, chape sur plancher chauffant et ragréage dans le district de Morges."
  })} />

  <Navbar />

  <!-- HEADER -->
  <section class="relative bg-gray-900 text-white pt-48 pb-20 overflow-hidden">
    <div class="absolute inset-0">
      <img src="/images/sols.jpg" alt="Sols, dalles et chapes district de Morges" class="w-full h-full object-cover opacity-25" />
    </div>
    <div class="relative max-w-[1440px] mx-auto px-6">
      <p class="text-xs font-semibold tracking-widest uppercase text-[#FF7500] mb-4">Domaines d'intervention</p>
      <h1 class="text-4xl md:text-6xl font-black leading-tight max-w-3xl">
        Sols et planchers.
      </h1>
      <p class="text-gray-300 mt-6 text-lg max-w-xl">
        Dalle en béton, chape, ragréage — le support sur lequel tout le reste vient se poser.
      </p>
      <div class="flex flex-wrap gap-4 mt-10">
        <a href="/contact" class="btn-orange btn-orange-on-dark px-8 py-4 text-sm font-bold tracking-widest uppercase rounded-sm">
          <span>Demander un devis gratuit</span>
        </a>
        <a href="tel:+41218610155" class="px-8 py-4 text-sm font-bold tracking-widest uppercase text-white border border-white/40 hover:border-white transition-colors rounded-sm">
          +41 21 861 01 55
        </a>
      </div>
    </div>
  </section>

  <!-- PRESTATIONS -->
  <section class="py-20 bg-white">
    <div class="max-w-[1440px] mx-auto px-6">
      <p class="text-xs font-semibold tracking-widest uppercase text-[#FF7500] mb-4">Ce qu'on fait</p>
      <h2 class="text-3xl font-bold mb-4">De la dalle porteuse à la chape de finition.</h2>
      <p class="text-gray-500 mb-14 max-w-xl">Un carrelage qui se décolle ou un parquet qui gondole vient presque toujours de ce qu'il y a en dessous.</p>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {prestations.map(p => (
          <div class="bg-gray-50 rounded-xl p-6 border-t-2 border-[#FF7500]">
            <h3 class="text-base font-bold mb-2">{p.titre}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PHOTO + TEXTE -->
  <section class="py-20 bg-gray-50 border-y border-gray-100">
    <div class="max-w-[1440px] mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-16 items-center">
        <div>
          <p class="text-xs font-semibold tracking-widest uppercase text-[#FF7500] mb-4">Notre approche</p>
          <h2 class="text-3xl font-bold mb-6">Une chape se juge au temps qu'on lui laisse.</h2>
          <p class="text-gray-600 leading-relaxed mb-4">La plupart des problèmes de sol viennent d'un séchage écourté. La chape a l'air sèche en surface bien avant de l'être à cœur, et le revêtement posé trop tôt enferme l'humidité restante. C'est souvent là que se joue la différence entre un sol qui tient et un sol qu'il faut reprendre.</p>
          <p class="text-gray-600 leading-relaxed mb-4">Sur un chantier avec plancher chauffant, on cale nos dates avec le chauffagiste et le carreleur avant de couler, pour que le planning tienne compte du séchage plutôt que de le subir.</p>
          <p class="text-gray-600 leading-relaxed mb-8">Zone d'intervention : district de Morges, Rolle, Aubonne, Cossonay et environs.</p>
          <a href="/contact" class="btn-orange inline-block px-8 py-4 text-sm font-bold tracking-widest uppercase rounded-sm">
            <span>Prendre contact</span>
          </a>
        </div>
        <div class="aspect-[4/3] overflow-hidden">
          <img src="/images/sols.jpg" alt="Coulage d'une chape dans le canton de Vaud" class="w-full h-full object-cover" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-white">
    <div class="max-w-[1440px] mx-auto px-6">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold tracking-widest uppercase text-[#FF7500] mb-4">Questions fréquentes</p>
        <h2 class="text-3xl font-bold mb-12">Vos questions sur les sols.</h2>
        <div class="space-y-0">
          {faq.map(item => (
            <details class="group border-t border-gray-200">
              <summary class="flex items-center justify-between py-5 cursor-pointer list-none select-none gap-4">
                <span class="text-sm font-semibold text-gray-900 leading-snug">{item.q}</span>
                <span class="text-[#FF7500] font-bold text-xl leading-none w-5 text-center flex-shrink-0 group-open:hidden">+</span>
                <span class="text-[#FF7500] font-bold text-xl leading-none w-5 text-center flex-shrink-0 hidden group-open:block">−</span>
              </summary>
              <p class="pb-6 text-sm text-gray-600 leading-relaxed">{item.a}</p>
            </details>
          ))}
          <div class="border-t border-gray-200"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-gray-900 text-white">
    <div class="max-w-[1440px] mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Un sol à refaire ?</h2>
      <p class="text-gray-400 mb-10">Visite sur place gratuite. Devis détaillé, sans engagement.</p>
      <a href="/contact" class="btn-orange btn-orange-on-dark inline-block px-12 py-4 text-sm font-bold tracking-widest uppercase rounded-sm">
        <span>Demander une visite gratuite</span>
      </a>
    </div>
  </section>

  <Footer />
</Layout>
