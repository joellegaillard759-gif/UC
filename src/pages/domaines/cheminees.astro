---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const prestations = [
  { titre: "Réfection de souche", desc: "La partie de la cheminée qui sort du toit prend tout : pluie, gel, vent. Reprise des joints, remplacement des éléments éclatés, ou démolition et remontage complet quand elle est trop atteinte." },
  { titre: "Étanchéité en toiture", desc: "Reprise du raccord entre la souche et la couverture — solin, bavette, contre-solin. C'est de là que viennent la plupart des infiltrations attribuées à la cheminée." },
  { titre: "Rénovation du foyer", desc: "Reprise de la maçonnerie du foyer : remplacement des briques réfractaires, rejointoiement au mortier réfractaire, reconstruction de l'âtre." },
  { titre: "Construction de cheminée", desc: "Montage d'une cheminée maçonnée, du socle à la souche. Le foyer ou l'insert est fourni et raccordé par le poêlier ; nous montons ce qui l'entoure et le conduit maçonné." },
  { titre: "Travaux liés au tubage", desc: "Le tubage lui-même est posé par le ramoneur ou le poêlier. Nous faisons ce qui l'accompagne : ouverture du conduit, reprise de la maçonnerie, rebouchage et finitions." },
  { titre: "Démolition de cheminée", desc: "Dépose d'une cheminée hors service, obturation du conduit, reprise du toit et du plafond — pour récupérer la place ou supprimer un point d'infiltration." },
];

const faq = [
  {
    q: "Mon foyer refoule la fumée dans la pièce — d'où ça vient ?",
    a: "Souvent d'un manque d'air plutôt que d'un problème de conduit : une maison bien étanche, une hotte de cuisine ou une ventilation qui tourne créent une dépression, et la fumée prend le chemin le plus facile. Les autres causes fréquentes sont un conduit encrassé, une souche trop basse par rapport au faîte, ou un foyer mal dimensionné pour son conduit. Le premier réflexe est d'entrouvrir une fenêtre pour voir si ça change : si oui, c'est l'air. Ensuite, appelez votre ramoneur — c'est lui qui contrôle le conduit.",
  },
  {
    q: "Qui fait le contrôle officiel du conduit ?",
    a: "Le ramoneur de votre secteur, désigné par la commune. C'est lui qui procède au ramonage réglementaire et qui atteste de la conformité de l'installation. Nous ne délivrons aucune attestation et nous ne remplaçons pas son contrôle. En revanche, quand il relève un défaut de maçonnerie, nous faisons les travaux — et nous préférons travailler avec lui plutôt qu'à sa place.",
  },
  {
    q: "Ma souche laisse passer l'eau — faut-il tout démolir ?",
    a: "Rarement. Dans la plupart des cas, l'eau ne passe pas par la maçonnerie mais par le raccord entre la souche et la couverture, ou par un couronnement fissuré. Reprendre le solin et le couronnement suffit alors. La démolition-reconstruction se justifie quand la maçonnerie elle-même est désagrégée par le gel sur toute la hauteur.",
  },
  {
    q: "Je veux supprimer une cheminée que je n'utilise plus.",
    a: "C'est faisable, et souvent une bonne idée : une cheminée inutilisée continue de prendre l'eau et de coûter en entretien. Il faut décider jusqu'où descendre — souche seule, jusqu'aux combles, ou tout le conduit — reboucher proprement à chaque niveau traversé, et refaire la couverture au droit de l'ouverture. Si la cheminée dessert encore un autre logement, ce qui arrive en immeuble, la question se règle avant les travaux.",
  },
];
---

<Layout
  title="Cheminées — Souche, foyer, étanchéité | Urben Construction"
  description="Réfection de souche, étanchéité en toiture, rénovation de foyer et démolition de cheminée dans le district de Morges. Visite sur place gratuite."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Cheminées",
    "provider": {
      "@type": "LocalBusiness",
      "name": "Urben Construction",
      "url": "https://urbenconstruction.ch",
      "telephone": "+41218610155",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Grancy",
        "addressRegion": "Vaud",
        "addressCountry": "CH"
      }
    },
    "areaServed": "District de Morges, Vaud, Suisse",
    "description": "Réfection de souche, étanchéité en toiture, rénovation de foyer, construction et démolition de cheminée dans le district de Morges."
  })} />

  <Navbar />

  <!-- HEADER -->
  <section class="relative bg-gray-900 text-white pt-48 pb-20 overflow-hidden">
    <div class="absolute inset-0">
      <img src="/images/cheminee.jpg" alt="Rénovation de cheminée district de Morges" class="w-full h-full object-cover opacity-25" />
    </div>
    <div class="relative max-w-[1440px] mx-auto px-6">
      <p class="text-xs font-semibold tracking-widest uppercase text-[#FF7500] mb-4">Domaines d'intervention</p>
      <h1 class="text-4xl md:text-6xl font-black leading-tight max-w-3xl">
        Cheminées.
      </h1>
      <p class="text-gray-300 mt-6 text-lg max-w-xl">
        Souche, foyer, étanchéité en toiture — la maçonnerie de votre cheminée, du socle au chapeau.
      </p>
      <div class="flex flex-wrap gap-4 mt-10">
        <a href="/contact" class="btn-orange btn-orange-on-dark px-8 py-4 text-sm font-bold tracking-widest uppercase rounded-sm">
          <span>Demander un devis gratuit</span>
        </a>
        <a href="tel:+41218610155" class="px-8 py-4 text-sm font-bold tracking-widest uppercase text-white border border-white/40 hover:border-white transition-colors rounded-sm">
          +41 21 861 01 55
        </a>
      </div>
    </div>
  </section>

  <!-- PRESTATIONS -->
  <section class="py-20 bg-white">
    <div class="max-w-[1440px] mx-auto px-6">
      <p class="text-xs font-semibold tracking-widest uppercase text-[#FF7500] mb-4">Ce qu'on fait</p>
      <h2 class="text-3xl font-bold mb-4">La maçonnerie, pas le ramonage.</h2>
      <p class="text-gray-500 mb-14 max-w-xl">Notre part, c'est la pierre, la brique et le mortier — de l'âtre jusqu'au chapeau.</p>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {prestations.map(p => (
          <div class="bg-gray-50 rounded-xl p-6 border-t-2 border-[#FF7500]">
            <h3 class="text-base font-bold mb-2">{p.titre}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PHOTO + TEXTE -->
  <section class="py-20 bg-gray-50 border-y border-gray-100">
    <div class="max-w-[1440px] mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-16 items-center">
        <div>
          <p class="text-xs font-semibold tracking-widest uppercase text-[#FF7500] mb-4">Notre approche</p>
          <h2 class="text-3xl font-bold mb-6">Chacun son métier.</h2>
          <p class="text-gray-600 leading-relaxed mb-4">Une cheminée fait intervenir trois métiers : le ramoneur pour le conduit et le contrôle, le poêlier pour le foyer et le tubage, le maçon pour tout ce qui est maçonné. Nous sommes le troisième. On ne délivre pas d'attestation de conformité et on ne se substitue pas au contrôle officiel.</p>
          <p class="text-gray-600 leading-relaxed mb-4">Cela dit, la plupart des problèmes qu'on nous appelle à régler — souche fissurée, infiltration au droit du toit, couronnement éclaté par le gel — sont bien de la maçonnerie. Quand ce n'en est pas, on vous le dit et on vous oriente.</p>
          <p class="text-gray-600 leading-relaxed mb-8">Zone d'intervention : district de Morges, Rolle, Aubonne, Cossonay et environs.</p>
          <a href="/contact" class="btn-orange inline-block px-8 py-4 text-sm font-bold tracking-widest uppercase rounded-sm">
            <span>Prendre contact</span>
          </a>
        </div>
        <div class="aspect-[4/3] overflow-hidden">
          <img src="/images/cheminee.jpg" alt="Réfection de cheminée dans le canton de Vaud" class="w-full h-full object-cover" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-white">
    <div class="max-w-[1440px] mx-auto px-6">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold tracking-widest uppercase text-[#FF7500] mb-4">Questions fréquentes</p>
        <h2 class="text-3xl font-bold mb-12">Vos questions sur les cheminées.</h2>
        <div class="space-y-0">
          {faq.map(item => (
            <details class="group border-t border-gray-200">
              <summary class="flex items-center justify-between py-5 cursor-pointer list-none select-none gap-4">
                <span class="text-sm font-semibold text-gray-900 leading-snug">{item.q}</span>
                <span class="text-[#FF7500] font-bold text-xl leading-none w-5 text-center flex-shrink-0 group-open:hidden">+</span>
                <span class="text-[#FF7500] font-bold text-xl leading-none w-5 text-center flex-shrink-0 hidden group-open:block">−</span>
              </summary>
              <p class="pb-6 text-sm text-gray-600 leading-relaxed">{item.a}</p>
            </details>
          ))}
          <div class="border-t border-gray-200"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-gray-900 text-white">
    <div class="max-w-[1440px] mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Une cheminée à reprendre ?</h2>
      <p class="text-gray-400 mb-10">Visite sur place gratuite. Devis détaillé, sans engagement.</p>
      <a href="/contact" class="btn-orange btn-orange-on-dark inline-block px-12 py-4 text-sm font-bold tracking-widest uppercase rounded-sm">
        <span>Demander une visite gratuite</span>
      </a>
    </div>
  </section>

  <Footer />
</Layout>
